{{define "document"}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{template "page:title" .}} - AIS Test Bench</title>
    {{- range .Stylesheets}}
    <link rel="stylesheet" href="{{.}}">
    {{- end}}
    {{- with .Module}}
    <script type="module" src="{{.}}"></script>
    {{- end}}
    {{- range .Scripts}}
    <script defer src="{{.}}"></script>
    {{- end}}
</head>
<body>
    <header>
        {{if .HomeURL}}<a href="{{.HomeURL}}">AIS Test Bench</a>{{else}}<span>AIS Test Bench</span>{{end}}
        <nav>
            {{- with .ManagerURL}}
            <a href="{{.}}">Manager</a>
            {{- end}}
            {{- with .DisplayURL}}
            <a href="{{.}}">Display</a>
            {{- end}}
        </nav>
    </header>
    <main>
        {{template "page:content" .}}
    </main>
</body>
</html>
{{end}}
