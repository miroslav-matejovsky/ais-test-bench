{{define "page:content"}}
<h1>Display</h1>
<p>Synthetic vessel traffic off Rotterdam. Positions refresh every second.</p>
<div class="toolbar">
    <p id="live-status" role="status">Connecting...</p>
    <button id="fit-vessels" type="button">Show all vessels</button>
</div>
<p id="tile-status" role="status"></p>
<div id="map" aria-label="Live vessel map"></div>
<p>Click a vessel for its MMSI, speed, course, and latest position.</p>
<noscript>Enable JavaScript to view the live map.</noscript>
{{end}}
