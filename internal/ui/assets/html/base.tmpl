{{define "base"}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{template "page:title" .}} - AIS Test Bench</title>
    <link rel="stylesheet" href="/static/css/app.css">
    <script defer src="/static/js/htmx.min.js"></script>
    {{block "page:head" .}}{{end}}
</head>
<body>
    <header>
        <a href="/">AIS Test Bench</a>
        <nav>
            {{- range nav}}
            <a href="{{.Href}}">{{.Label}}</a>
            {{- end}}
        </nav>
    </header>
    <main>
        {{template "page:content" .}}
    </main>
</body>
</html>
{{end}}
